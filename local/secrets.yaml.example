# Скопіюй у secrets.yaml (поряд із конфігами) і заповни.
# ESPHome шукає secrets.yaml поряд із конфігом. НЕ комітити.

wifi_ssid: "YOUR_WIFI"
wifi_password: "YOUR_WIFI_PASSWORD"

# Брокер MQTT (рішення B, labems-7f6.5): LAN-слухач на 192.168.88.22:1883
# (зарезервований WiFi-IP Radxa, MAC 10:4a:7d:2b:66:1e — стабільний і після зняття Ethernet),
# обліковий запис НА ПЛАТУ (jk-bms-a / jk-bms-b), ACL строго jkbms/string_<x>/#.
# Логін береться з ${board_name} у конфізі — тут лише пароль (спільний для обох
# акаунтів; якщо треба різні — тримай окремий secrets.yaml на кожну плату).
# УВАГА: LAN-слухач на Rock 3A ще НЕ розгорнуто (окрема транзакція власника) —
# до того MQTT-публікація не пройде, але BLE-декод видно в USB-логах.
mqtt_host: "192.168.88.22"
mqtt_password: "CHANGE_ME"

ota_password: "CHANGE_ME_OTA"
